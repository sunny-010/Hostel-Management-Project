generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  password     String
  role         UserRole
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       UserStatus @default(ACTIVE)
  phone        String?
  profileImage String?    @db.Text
  auditLogs    AuditLog[]
  student      Student?
}

model Student {
  id            Int                @id @default(autoincrement())
  studentId     String             @unique
  name          String
  email         String             @unique
  phone         String?
  department    String?
  year          Int?
  createdAt     DateTime           @default(now())
  userId        Int                @unique
  complaints    Complaint[]
  fees          Fee[]
  leaveRequests LeaveApplication[]
  allocations   RoomAllocation[]
  user          User               @relation(fields: [userId], references: [id])
}

model Hostel {
  id        Int      @id @default(autoincrement())
  name      String
  block     String
  createdAt DateTime @default(now())
  blocks    Block[]
  rooms     Room[]
}

model Block {
  id       Int    @id @default(autoincrement())
  name     String
  hostelId Int
  hostel   Hostel @relation(fields: [hostelId], references: [id])
  rooms    Room[]

  @@unique([hostelId, name])
}

model Room {
  id          Int              @id @default(autoincrement())
  roomNumber  String
  capacity    Int
  occupied    Int              @default(0)
  hostelId    Int
  blockId     Int
  block       Block            @relation(fields: [blockId], references: [id])
  hostel      Hostel           @relation(fields: [hostelId], references: [id])
  allocations RoomAllocation[]

  @@unique([hostelId, roomNumber])
  @@unique([blockId, roomNumber])
}

model RoomAllocation {
  id          Int      @id @default(autoincrement())
  allocatedAt DateTime @default(now())
  studentId   Int
  roomId      Int
  room        Room     @relation(fields: [roomId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, roomId])
  @@index([roomId], map: "RoomAllocation_roomId_fkey")
}

model Fee {
  id        Int       @id @default(autoincrement())
  amount    Decimal   @db.Decimal(10, 2)
  status    FeeStatus @default(PENDING)
  dueDate   DateTime
  paidDate  DateTime?
  createdAt DateTime  @default(now())
  studentId Int
  student   Student   @relation(fields: [studentId], references: [id])

  @@index([studentId], map: "Fee_studentId_fkey")
}

model Complaint {
  id          Int             @id @default(autoincrement())
  title       String
  description String          @db.Text
  status      ComplaintStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  studentId   Int
  student     Student         @relation(fields: [studentId], references: [id])

  @@index([studentId], map: "Complaint_studentId_fkey")
}

model LeaveApplication {
  id        Int         @id @default(autoincrement())
  fromDate  DateTime
  toDate    DateTime
  reason    String      @db.Text
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  studentId Int
  student   Student     @relation(fields: [studentId], references: [id])

  @@index([studentId], map: "LeaveApplication_studentId_fkey")
}

model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actorName   String
  actorEmail  String
  action      String
  entity      String
  entityId    Int?
  description String   @db.Text
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model SystemSettings {
  id                 Int      @id @default(1)
  systemName         String   @default("HostelHub")
  institutionName    String   @default("Hostel Management System")
  contactEmail       String?
  contactPhone       String?
  maintenanceMode    Boolean  @default(false)
  allowAdminCreation Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
